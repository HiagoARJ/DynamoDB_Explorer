server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Mesmo papel do proxy do Vite: /localstack/* → LocalStack (evita CORS)
    location /localstack {
        rewrite ^/localstack/?(.*)$ /$1 break;
        proxy_pass ${LOCALSTACK_URL};
        proxy_http_version 1.1;
        # A chamada já é same-origin para o navegador; sem remover o Origin o LocalStack
        # aplica a política de CORS dele e responde 403 para origens como localhost:8080.
        proxy_set_header Origin "";
        proxy_set_header Referer "";
        proxy_read_timeout 120s;
        client_max_body_size 20m;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
